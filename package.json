{
  "name": "cachalot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "models:prepare": "node scripts/prepare-model.ts",
    "models:check": "node scripts/prepare-model.ts --check",
    "prebuild": "npm run models:check",
    "build": "tsc --noEmit && vite build",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:paper": "node --import tsx scripts/run-paper-tests.ts",
    "test:all": "npm run test:types && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:types": "tsc --noEmit --project tsconfig.tests.json",
    "test:analysis": "node --import tsx tests/unit/analysis.test.ts",
    "test:formulas": "node --import tsx tests/unit/formulas.test.ts",
    "test:formula-transcription": "node --import tsx tests/unit/formula-transcription.test.ts",
    "test:headings": "node --import tsx tests/unit/heading-translation.test.ts",
    "test:formula-transcription-ui": "node --import tsx scripts/run-paper-tests.ts tests/e2e/formulas-transcription.spec.ts",
    "test:formula-sources": "node --import tsx tests/integration/formula-sources.ts",
    "test:paper": "node --import tsx scripts/inspect-paper.ts",
    "test:browser": "node --import tsx scripts/run-paper-tests.ts tests/e2e/reader-analysis.spec.ts",
    "test:styles": "node --import tsx scripts/run-paper-tests.ts tests/e2e/visual-layout.spec.ts",
    "test:i18n": "node --import tsx tests/unit/i18n.test.ts",
    "test:api-key": "playwright test tests/e2e/models-credentials.spec.ts",
    "test:key-storage": "node --import tsx tests/integration/browser-provider-keys.test.ts",
    "test:api-endpoint": "node --import tsx tests/integration/api-endpoint.test.ts",
    "test:provider-models": "node --import tsx tests/integration/provider-models.test.ts",
    "test:ocr": "node --import tsx tests/integration/ocr.test.ts",
    "test:added-model-ui": "node --import tsx scripts/run-paper-tests.ts tests/e2e/models-added.spec.ts",
    "test:provider-errors": "node --import tsx tests/integration/provider-error.test.ts",
    "test:provider-error-ui": "node --import tsx scripts/run-paper-tests.ts tests/e2e/models-errors.spec.ts",
    "test:reader": "node --import tsx tests/unit/page-layout.test.ts",
    "test:reader-navigation": "node --import tsx scripts/run-paper-tests.ts tests/e2e/reader-navigation.spec.ts",
    "test:categories": "node --import tsx tests/integration/categories.test.ts",
    "test:category-ui": "node --import tsx scripts/run-paper-tests.ts tests/e2e/library-categories.spec.ts",
    "test:library-sort": "node --import tsx tests/unit/library-sort.test.ts",
    "test:library-sort-ui": "playwright test tests/e2e/library-sort.spec.ts",
    "format": "prettier --write src/App.tsx src/components src/styles src/i18n src/main.tsx vite.config.ts",
    "format:check": "prettier --check src/App.tsx src/components src/styles src/i18n src/main.tsx vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@embedpdf/pdfium": "2.15.1",
    "@tauri-apps/api": "^2.11.1",
    "i18next": "26.4.2",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.15",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
