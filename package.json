{
  "name": "cachalot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "models:prepare": "node scripts/prepare-model.ts",
    "models:check": "node scripts/prepare-model.ts --check",
    "prebuild": "npm run models:check",
    "build": "tsc --noEmit && vite build",
    "test:analysis": "node --import tsx tests/analysis.test.ts",
    "test:formulas": "node --import tsx tests/formulas.test.ts",
    "test:formula-transcription": "node --import tsx tests/formula-transcription.test.ts",
    "test:headings": "node --import tsx tests/heading-translation.test.ts",
    "test:formula-transcription-ui": "node --import tsx scripts/verify-formula-transcription.ts",
    "test:formula-sources": "node --import tsx scripts/verify-formula-sources.ts",
    "test:paper": "node --import tsx scripts/inspect-paper.ts",
    "test:browser": "node --import tsx scripts/verify-browser.ts",
    "test:styles": "node --import tsx scripts/verify-styles.ts",
    "test:i18n": "node --import tsx tests/i18n.test.ts",
    "test:api-key": "node --import tsx scripts/verify-api-key.ts",
    "test:key-storage": "node --import tsx tests/browser-provider-keys.test.ts",
    "test:api-endpoint": "node --import tsx tests/api-endpoint.test.ts",
    "test:provider-models": "node --import tsx tests/provider-models.test.ts",
    "test:ocr": "node --import tsx tests/ocr.test.ts",
    "test:added-model-ui": "node --import tsx scripts/verify-added-models.ts",
    "test:provider-errors": "node --import tsx tests/provider-error.test.ts",
    "test:provider-error-ui": "node --import tsx scripts/verify-provider-errors.ts",
    "test:reader": "node --import tsx tests/page-layout.test.ts",
    "test:reader-navigation": "node --import tsx scripts/verify-reader-navigation.ts",
    "test:categories": "node --import tsx tests/categories.test.ts",
    "test:category-ui": "node --import tsx scripts/verify-categories.ts",
    "test:library-sort": "node --import tsx tests/library-sort.test.ts",
    "test:library-sort-ui": "node --import tsx scripts/verify-library-sort.ts",
    "format": "prettier --write src/App.tsx src/components src/styles src/i18n src/main.tsx vite.config.ts",
    "format:check": "prettier --check src/App.tsx src/components src/styles src/i18n src/main.tsx vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@embedpdf/pdfium": "2.15.1",
    "@tauri-apps/api": "^2.11.1",
    "i18next": "26.4.2",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.15",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
